# ─────────────────────────────────────────────────────────────
# 글로벌(OpenAI) 모델 — 평가 + 파인튜닝
# ─────────────────────────────────────────────────────────────
# OpenAI API 키 (필수: 글로벌 모델 평가/파인튜닝)
OPENAI_API_KEY=sk-...

# (선택) 파인튜닝/평가에 사용할 베이스 모델 ID 오버라이드.
# 비워두면 training/config.py 의 기본값을 사용합니다.
# - 파인튜닝 가능 스냅샷 예시: gpt-4o-2024-08-06, gpt-4.1-2025-04-14, gpt-4o-mini-2024-07-18
# - GPT-5 계열은 계정 권한에 따라 모델 ID/파인튜닝 가능 여부가 다릅니다. 콘솔에서 확인 후 입력하세요.
GPT4_MODEL=gpt-4o-2024-08-06
GPT5_MODEL=gpt-5

# (선택) 파인튜닝 완료 후 생성된 모델 ID를 여기에 넣으면 evaluate.py 가 함께 평가합니다.
GPT4_FINETUNED_MODEL=
GPT5_FINETUNED_MODEL=

# ─────────────────────────────────────────────────────────────
# 로컬(한국형) 모델 — Ollama 의 OpenAI 호환 엔드포인트로 평가
# ─────────────────────────────────────────────────────────────
# Ollama 설치 후 `ollama pull exaone3.5:7.8b` 로 모델을 받으세요.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
# `ollama list` 에 보이는 태그와 일치해야 합니다.
LOCAL_MODEL=exaone3.5:7.8b

# ─────────────────────────────────────────────────────────────
# 글로벌 모델 provider — 기본은 local(Ollama)
#   ⚠️ GLOBAL_PROVIDER 기본값이 local 이라, "글로벌" 자리(qwen2.5:7b)도 Ollama 로 평가됩니다.
#      실제 OpenAI 클라우드로 평가하려면 openai 로 바꾸고 OPENAI_API_KEY 를 채우세요.
# ─────────────────────────────────────────────────────────────
GLOBAL_PROVIDER=local
GLOBAL_MODEL=qwen2.5:7b
# OPENAI_BASE_URL=          # OpenAI 호환 타 엔드포인트 사용 시에만
# EXPLANATION_MODEL=        # 해설 생성 모델(기본: GPT4_MODEL)
# RAG_TOP_K=6               # 용어 RAG 주입 상위 K(기본 6)

# ─────────────────────────────────────────────────────────────
# GraphRAG (graphrag/, bigse0u1/) — Neo4j + Chroma + LLM
#   step1(그래프 적재)·step3/step4(GraphRAG 질의·평가)에서 사용.
# ─────────────────────────────────────────────────────────────
# ⚠️ Docker(bolt://neo4j:7687) vs 네이티브(localhost). docker-compose 사용 시 이 URI는
#    compose 의 environment 가 자동으로 서비스명(neo4j)으로 덮어씁니다.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# ⚠️ Neo4j 는 비밀번호로 'neo4j'(기본값)를 거부합니다 → 반드시 다른 값을 쓰세요.
#    docker-compose 는 이 값을 NEO4J_AUTH(neo4j/<PW>)로 사용합니다. 공유 환경에선 교체하세요.
NEO4J_PW=ktmpassword
# GraphRAG 질의 LLM: ollama(기본) / openai / anthropic / groq
LLM_PROVIDER=ollama
# LLM_MODEL=               # provider별 기본값 → ollama:qwen2.5 · openai:gpt-4o-mini · anthropic:claude-sonnet-4-6 · groq:llama-3.1-8b-instant
# ANTHROPIC_API_KEY=       # LLM_PROVIDER=anthropic 일 때 필요
# GROQ_API_KEY=            # LLM_PROVIDER=groq 일 때 필요
